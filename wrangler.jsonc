{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"triggers": {
		"crons": ["0 1 * * *"]
	},
	"name": "suwei-web",
	"compatibility_date": "2026-07-22",
	"workers_dev": true,
	"preview_urls": true,
	"vars": {
		"BETTER_AUTH_URL": "https://tuzhuzu.cn",
		"ALIYUN_SMS_RENTAL_CREATED_TEMPLATE_CODE": "SMS_510980016",
		"ALIYUN_SMS_REMINDER_TEMPLATE_CODE": "SMS_510885024"
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "suwei-web"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "suwei-db",
			"database_id": "f4ce4067-8b29-4186-83d7-49a48b8a1206",
			"migrations_dir": "migrations/d1"
		}
	],
	"observability": {
		"enabled": true
	}
	// 注意：这个账号目前是 Cloudflare Workers Free 计划，Free 计划不允许自定义 limits.cpu_ms
	// （试过设置直接导致部署失败：code 100328 "CPU limits are not supported for the Free plan"），
	// 且 Free 计划每次请求本身就只有 10ms CPU 时间（付费计划是 30s，还可以调到最高 300000ms）。
	// 也就是说这个账号下"CPU 用超"的容错空间比想象中小得多。真正的修复是 overdue-rent-billing.ts
	// 里把"逾期账单自愈"全店铺扫描的节流状态从模块级 Map 改成 D1 表共享的原子锁，从根上防止同一
	// 用户的重复全店铺扫描在多个 Worker 副本里并发执行。如果以后升级到付费计划，可以在这里加回
	// "limits": { "cpu_ms": <想要的值，最高 300000 > } 作为额外安全余量。
}
