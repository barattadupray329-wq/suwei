{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"triggers": {
		"crons": ["0 1 * * *"]
	},
	"name": "suwei-web",
	"compatibility_date": "2026-07-22",
	"workers_dev": true,
	"preview_urls": true,
	"vars": {
		"BETTER_AUTH_URL": "https://tuzhuzu.cn",
		"ALIYUN_SMS_RENTAL_CREATED_TEMPLATE_CODE": "SMS_510980016",
		"ALIYUN_SMS_REMINDER_TEMPLATE_CODE": "SMS_510885024"
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "suwei-web"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "suwei-db",
			"database_id": "f4ce4067-8b29-4186-83d7-49a48b8a1206",
			"migrations_dir": "migrations/d1"
		}
	],
	"observability": {
		"enabled": true
	},
	// 默认每次调用限 30 秒 CPU 时间（付费计划最高可设 300000ms）。列表页/看板页背后的"逾期账单
	// 自愈"全店铺扫描在数据量较大或高并发时曾把单次调用的 CPU 用超，触发 Error 1102
	// "Worker exceeded resource limits"。这里把上限调到 2 分钟留出安全余量，配合
	// overdue-rent-billing.ts 里改成跨 Worker 副本共享的 D1 节流锁（而非仅单副本内存节流）
	// 一起使用——节流锁从根上防止同一用户的重复全店铺扫描并发执行，这里只是兜底余量。
	"limits": {
		"cpu_ms": 120000
	}
}
